{
  "mcpServers": {
    "codex-must-work": {
      "command": "runtime/launch-python.exe",
      "args": [
        "scripts/mcp_bootstrap.py"
      ],
      "cwd": ".",
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONUTF8": "1"
      },
      "required": true,
      "startup_timeout_sec": 60,
      "tool_timeout_sec": 120,
      "supports_parallel_tool_calls": false
    }
  }
}
